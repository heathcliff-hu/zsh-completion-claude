# ShellCheck configuration for _claude zsh completion script
# Target: zsh (but ShellCheck doesn't support zsh natively; use bash as closest approximation)
shell=bash

# Enable optional checks
enable=avoid-nullary-conditions,require-variable-braces,check-unassigned-uppercase

# Disable specific rules for zsh compatibility:
# SC1009: zsh-specific syntax (this is a zsh script, not bash/sh)
# SC1036/SC1058/SC1072/SC1073: zsh glob qualifiers like (N), (om[1,20]) confuse the bash parser
# SC1091: sourced files are zsh fpath files, not present in repo
disable=SC1009,SC1036,SC1058,SC1072,SC1073,SC1091
