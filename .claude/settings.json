{
    "permissions": {
        "allow": [
            "Read",
            "Glob",
            "Grep",
            "Bash(ls:*)",
            "Bash(awk *)",
            "Bash(git:*)",
            "Bash(zsh *)",
            "Bash(claude *)",
            "Bash(sed -n *)",
            "Bash(python3 *)",
            "ExecuteExtraTool",
            "Bash(autoload -Uz _claude)",
            "Bash(rm -f ~/.zcompdump* *)",
            "Bash(xargs basename .jsonl)",
            "Bash(xargs -I{} echo ~/.claude/projects/{})",
            "Skill(shell-scripting:bash-defensive-patterns)",
            "Skill(shell-scripting:shellcheck-configuration)"
        ]
    },
    "enabledPlugins": {
        "shell-scripting@claude-code-workflows": true
    }
}