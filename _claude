_claude_mcp_servers() {
  _claude_need claude || return 1
  local -a items
  local slug="${PWD//\//-}"
  slug="${slug//./-}"
  local cache_file="$ZSH_CACHE_DIR/zsh_claude_mcp_servers_$slug"

  # cache with 1h TTL: line1 = epoch, rest = server names
  if [[ -f $cache_file ]] && (( EPOCHSECONDS - $(head -1 $cache_file) < 3600 )); then
    items=(${(f)"$(tail -n +2 $cache_file)"})
  else
    items=("${(@f)$(claude mcp list 2>/dev/null | grep ':')}")
    if [[ ${#items} -gt 0 ]]; then
      local tmp="${cache_file}.tmp.$$"
      { print -r -- "$EPOCHSECONDS"; print -l -- "${items[@]}"; } > "$tmp" && mv "$tmp" "$cache_file"
    fi
  fi

  [[ ${#items} -eq 0 ]] && return 1

  # Escape : in server names for _describe (e.g. "plugin:playwright" -> "plugin\:playwright")
  local -a transformed
  local name rest
  for item in "${items[@]}"; do
    name="${item%%: *}"
    rest="${item##*: }"
    if [[ "$name" == "$item" ]]; then
      transformed+=("$item")
    else
      name="${name//:/\\:}"
      transformed+=("${name}: ${rest}")
    fi
  done

  _describe 'server' transformed
}

