# --- model candidates --------------------------------------------------------
# Resolves model aliases from settings files (highest priority wins):
#   .claude/settings.local.json > .claude/settings.json > ~/.claude/settings.json
_claude_models() {
  local f sonnet_m opus_m haiku_m default_m
  local sonnet_s opus_s haiku_s default_s
  
  for f in .claude/settings.local.json .claude/settings.json ~/.claude/settings.json; do
    [[ -f $f ]] || continue
    
    [[ -z $sonnet_m ]] && sonnet_m=$(jq -r '.env.ANTHROPIC_DEFAULT_SONNET_MODEL // .env.ANTHROPIC_DEFAULT_SONNET_MODEL_NAME // empty' "$f" 2>/dev/null) && [[ -n $sonnet_m ]] && sonnet_s=${f/$HOME/~}
    [[ -z $opus_m ]]   && opus_m=$(jq -r '.env.ANTHROPIC_DEFAULT_OPUS_MODEL // .env.ANTHROPIC_DEFAULT_OPUS_MODEL_NAME // empty' "$f" 2>/dev/null)     && [[ -n $opus_m ]]   && opus_s=${f/$HOME/~}
    [[ -z $haiku_m ]]  && haiku_m=$(jq -r '.env.ANTHROPIC_DEFAULT_HAIKU_MODEL // empty' "$f" 2>/dev/null) && [[ -n $haiku_m ]]  && haiku_s=${f/$HOME/~}
    [[ -z $default_m ]] && default_m=$(jq -r '.env.ANTHROPIC_MODEL // empty' "$f" 2>/dev/null) && [[ -n $default_m ]] && default_s=${f/$HOME/~}
  done
  
  local -a models
  [[ -n $sonnet_m ]]  && models+=("sonnet:${sonnet_m} — ${sonnet_s}")
  [[ -n $opus_m ]]    && models+=("opus:${opus_m} — ${opus_s}")
  [[ -n $haiku_m ]]   && models+=("haiku:${haiku_m} — ${haiku_s}")
  [[ -n $default_m ]] && models+=("${default_m}:default (${default_s})")
  
  # fallback to bare aliases if nothing resolved
  [[ ${#models} -eq 0 ]] && models=('sonnet:Sonnet model' 'opus:Opus model' 'haiku:Haiku model')
  
  _describe 'model' models
}

# --- resume candidates --------------------------------------------------------
# Lists session .jsonl files from ~/.claude/projects/<slug>/
# where slug = $PWD with "/" replaced by "-"
_claude_resume() {
  local slug=${PWD//\//-}
  slug=${slug//./-}
  local dir=~/.claude/projects/$slug
  [[ -d $dir ]] || {
    dir=""
    local f
    for f in ~/.claude/projects/*/sessions-index.json(N); do
      if [[ "$(jq -r '.originalPath // ""' "$f" 2>/dev/null)" == "$PWD" ]]; then
        dir="${f:h}"
        break
      fi
    done
    [[ -z $dir ]] && return 1
  }

  local -a sessions
  sessions=(${(f)"$(
    for f in $dir/*.jsonl(N); do
      ts=$(stat -f '%m' "$f" 2>/dev/null) || continue
      id=${f:t:r}
      name=$(jq -r 'select(.type == "custom-title") | .customTitle // empty' "$f" 2>/dev/null | head -1)
      time_str=$(date -r "$ts" '+%Y-%m-%d %H:%M:%S')
      if [[ -n $name ]]; then
        print -r -- "$ts ${id}:${time_str}  ${name}"
      else
        print -r -- "$ts ${id}:${time_str}"
      fi
    done | sort -rn | cut -d' ' -f2-
  )"})

  [[ ${#sessions} -eq 0 ]] && return 1
  _describe -V 'session' sessions
}

