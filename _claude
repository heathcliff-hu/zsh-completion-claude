# --- model candidates --------------------------------------------------------
# Resolves model aliases from settings files (highest priority wins):
#   .claude/settings.local.json > .claude/settings.json > ~/.claude/settings.json
_claude_models() {
  _claude_need jq || return 1
  local f sonnet_m opus_m haiku_m default_m
  local sonnet_s opus_s haiku_s default_s
  
  for f in .claude/settings.local.json .claude/settings.json ~/.claude/settings.json; do
    [[ -f $f ]] || continue
    
    [[ -z $sonnet_m ]] && sonnet_m=$(jq -r '.env.ANTHROPIC_DEFAULT_SONNET_MODEL // .env.ANTHROPIC_DEFAULT_SONNET_MODEL_NAME // empty' "$f" 2>/dev/null) && [[ -n $sonnet_m ]] && sonnet_s=${f/$HOME/~}
    [[ -z $opus_m ]]   && opus_m=$(jq -r '.env.ANTHROPIC_DEFAULT_OPUS_MODEL // .env.ANTHROPIC_DEFAULT_OPUS_MODEL_NAME // empty' "$f" 2>/dev/null)     && [[ -n $opus_m ]]   && opus_s=${f/$HOME/~}
    [[ -z $haiku_m ]]  && haiku_m=$(jq -r '.env.ANTHROPIC_DEFAULT_HAIKU_MODEL // empty' "$f" 2>/dev/null) && [[ -n $haiku_m ]]  && haiku_s=${f/$HOME/~}
    [[ -z $default_m ]] && default_m=$(jq -r '.env.ANTHROPIC_MODEL // empty' "$f" 2>/dev/null) && [[ -n $default_m ]] && default_s=${f/$HOME/~}
  done
  
  local -a models
  [[ -n $sonnet_m ]]  && models+=("sonnet:${sonnet_m} — ${sonnet_s}")
  [[ -n $opus_m ]]    && models+=("opus:${opus_m} — ${opus_s}")
  [[ -n $haiku_m ]]   && models+=("haiku:${haiku_m} — ${haiku_s}")
  [[ -n $default_m ]] && models+=("${default_m}:default (${default_s})")
  
  # fallback to bare aliases if nothing resolved
  [[ ${#models} -eq 0 ]] && models=('sonnet:Sonnet model' 'opus:Opus model' 'haiku:Haiku model')
  
  _describe 'model' models
}

# --- resume candidates --------------------------------------------------------
# Lists session .jsonl files from ~/.claude/projects/<slug>/
# where slug = $PWD with "/" replaced by "-"
_claude_resume() {
  _claude_need jq || return 1
  local slug=${PWD//\//-}
  slug=${slug//./-}
  local dir=~/.claude/projects/$slug
  [[ -d $dir ]] || {
    dir=""
    local f
    for f in ~/.claude/projects/*/sessions-index.json(N); do
      if [[ "$(jq -r '.originalPath // ""' "$f" 2>/dev/null)" == "$PWD" ]]; then
        dir="${f:h}"
        break
      fi
    done
    [[ -z $dir ]] && return 1
  }

  # pick 20 most recent .jsonl files by mtime, then extract names
  local -a sessions recent
  recent=($dir/*.jsonl(om[1,20]N))

  local f ts id name time_str
  for f in $recent; do
    ts=$(zstat -F %s +mtime "$f" 2>/dev/null) || continue
    id=${f:t:r}
    name=$(jq -r 'select(.type == "custom-title") | .customTitle // empty' "$f" 2>/dev/null | head -1)
    time_str=$(strftime '%Y-%m-%d %H:%M:%S' "$ts")
    if [[ -n $name ]]; then
      sessions+=("${id}:${time_str}  ${name}")
    else
      sessions+=("${id}:${time_str}")
    fi
  done

  [[ ${#sessions} -eq 0 ]] && return 1
  _describe -V 'session' sessions
}

_cmd_plugin_dir() {
  _alternative \
  'directories:plugin directory:_files -/' \
  'zip-files:plugin zip file:_files -g "*.zip(-.)"'
}

_cmd_file_spec() {
  # 格式：file_id:relative_path
  # 已经输入冒号后，补 relative_path
  if compset -P '*:'; then
    _files
  else
    compadd -S ':' 'file_id'
  fi
}

# --- background session helpers -----------------------------------------------

_claude_bg_sessions() {
  _claude_need jq || return 1
  local -a items
  local jobs_dir=${CLAUDE_CONFIG_DIR:-~/.claude}/jobs
  local id ts time_str name state info

  [[ -d $jobs_dir ]] || return 1

  # collect dirs with mtime, sort desc, max 20
  local -a dir_lines
  dir_lines=(${(f)"$(
        for d in "$jobs_dir"/*(/om[1,20]N); do
          print -r -- "$(zstat -F %s +mtime "$d" 2>/dev/null) ${d:t}"
        done
  )"})

  for line in $dir_lines; do
    ts=${line%% *}
    id=${line#* }
    time_str=$(strftime '%Y-%m-%d %H:%M:%S' "$ts" 2>/dev/null)

    info=$(jq -r '
      ([.name, .displayName, .title, .sessionName, .intent, .daemonShort // ""] | map(select(. != null and . != ""))[0] // "") as $name |
      ([.state, .status, .lifecycle // ""] | map(select(. != null and . != ""))[0] // "") as $state |
      if $name != "" and $state != "" then
        "\($name) — \($state)"
      elif $name != "" then
        $name
      elif $state != "" then
        $state
      else
        ""
      end
    ' "$jobs_dir/$id/state.json" 2>/dev/null)

    if [[ -n $info ]]; then
      items+=("${id}:${time_str} - ${info}")
    else
      items+=("${id}:${time_str}")
    fi
  done

  [[ ${#items} -eq 0 ]] && return 1
  _describe -V 'session id' items
}

_claude_daemon_config_file() {
  _alternative \
  'default:default config file:compadd ~/.claude/daemon.json' \
  'files:config file:_path_files -g "*.json(-.)" -g ".*.json(-.)"'
}

_claude_daemon_log_file() {
  _alternative \
  'default:default log file:compadd ~/.claude/daemon.log' \
  'files:log file:_files'
}

_claude_daemon_cmds() {
  local -a subcmds
  subcmds=(
    'logs:tail the daemon log'
    'run:run the supervisor in the foreground'
    'status:show daemon pid, version, uptime'
    'stop:shut down the supervisor'
    'uninstall:remove the background service'
  )
  _describe 'daemon command' subcmds
}

_claude_daemon_run() {
  _arguments \
  '(-h --help)'{-h,--help}'[Display help]' \
  '::json path:_files'
}

_claude_daemon_stop() {
  _arguments \
  '--any[also stop a transient non-service daemon]' \
  '--keep-workers[leave detached sessions running]' \
  '(-h --help)'{-h,--help}'[Display help]'
}

_claude_daemon() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
  '--json-path[config file]:path:_claude_daemon_config_file' \
  '--log-file[log file]:path:_claude_daemon_log_file' \
  '(-h --help)'{-h,--help}'[Display help]' \
  '1: :_claude_daemon_cmds' \
  '*:: :->subargs' \
  && return

  case "$state" in
    subargs)
      case "$line[1]" in
        logs)      _claude_help_opts "$@" && return ;;
        run)       _claude_daemon_run "$@" && return ;;
        status)    _claude_help_opts "$@" && return ;;
        stop)      _claude_daemon_stop "$@" && return ;;
        uninstall) _claude_help_opts "$@" && return ;;
      esac
    ;;
  esac
}

_claude_attach() {
  _arguments \
  '(-h --help)'{-h,--help}'[Display help]' \
  '1:session id:_claude_bg_sessions'
}

_claude_respawn_cmd() {
  _arguments \
  '(1)--all[respawn every running session]' \
  '(-h --help)'{-h,--help}'[Display help]' \
  '(--all)1:session id:_claude_bg_sessions'
}

_claude_remote_control_cmd() {
  _arguments \
  '--name[set session name for Remote Control]:name: ' \
  '--remote-control-session-name-prefix[prefix for auto-generated session names]:prefix: ' \
  '(-h --help)'{-h,--help}'[Display help]'
}

_claude() {
  local -a opts
  local curcontext="$curcontext" ret=1 state line
  typeset -A opt_args
  
  if (( CURRENT > 2 )); then
    case "$words[2]" in
      agents)
        curcontext="${curcontext%:*:*}:claude-agents:"
        (( CURRENT-- ))
        shift words
        _claude_agents "$@"
        return
      ;;
    esac
  fi
  
  # --- main options ---
  # grouped for readability; empty description lines separate logical groups
  opts=(
    # Output / session control
    '(-p --print)'{-p,--print}'[print response and exit (non-interactive)]'
    '(-c --continue)'{-c,--continue}'[continue most recent conversation]'
    '(-r --resume)'{-r,--resume}'[resume conversation by session ID]:session:_claude_resume'
    '--fork-session[fork new session ID when resuming]'
    '--session-id[use specific session ID]:uuid: '
    '(-n --name)'{-n,--name}'[set display name for session]:name: '
    '--no-session-persistence[disable session persistence (--print only)]'
    '--bg[start session as background agent and return immediately]'
    '--exec[run shell command as background job (with --bg)]:command: '

    # Model / effort
    '--advisor[enable server-side advisor tool]:model:(opus sonnet fable)'
    '--model[model for current session]:model:_claude_models'
    '--effort[effort level for current session]:level:(low medium high xhigh max)'
    '--fallback-model[enable fallback to specified model(s)]:model:_claude_models'
    '--max-budget-usd[max dollar amount for API calls (--print only)]:amount: '
    '--max-turns[limit agent turns (--print only)]:turns:_numbers'
    
    # Input / output format
    '--input-format[input format (--print only)]:format:(text stream-json)'
    '--output-format[output format (--print only)]:format:(text json stream-json)'
    '--json-schema[JSON Schema for structured output validation]:schema: '
    '--include-partial-messages[include partial message chunks (--print + stream-json)]'
    '--include-hook-events[include hook lifecycle events (stream-json)]'
    '--replay-user-messages[re-emit user messages from stdin (stream-json)]'
    
    # Permissions / tools
    '--permission-mode[permission mode for session]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)'
    '*--tools[specify list of available tools]: :_claude_tool_names'
    '*--allowedTools[comma/space-separated tool names to allow]: :_claude_tool_names'
    '*--allowed-tools[comma/space-separated tool names to allow]: :_claude_tool_names'
    '*--disallowedTools[comma/space-separated tool names to deny]: :_claude_tool_names'
    '*--disallowed-tools[comma/space-separated tool names to deny]: :_claude_tool_names'
    '--allow-dangerously-skip-permissions[enable bypassing all permission checks as option]'
    '--dangerously-skip-permissions[bypass all permission checks]'
    '--permission-prompt-tool[specify MCP tool for permission prompts in non-interactive mode]:tool: '
    
    # System prompt / agents
    '--system-prompt[system prompt to use for session]:prompt: '
    '--system-prompt-file[replace system prompt from file]:file:_files'
    '--append-system-prompt[append system prompt to default]:prompt: '
    '--append-system-prompt-file[append system prompt from file]:file:_files'
    '--agent[agent for current session]:agent: '
    '--agents[json object defining custom agents]:json: '
    '*--betas[beta headers to include in API requests]:betas: '
    '--prompt-suggestions[enable prompt suggestions]::value:(preset true false 1 0 yes no on off)'
    
    # Directories / files / plugins
    '*--add-dir[additional directories for tool access]:directories:_directories'
    '*--file[file resources to download at startup]:spec (file_id\:relative_path):_cmd_file_spec'
    '*--plugin-dir[load plugin from directory or .zip]:path:_cmd_plugin_dir'
    '*--plugin-url[fetch plugin .zip from URL]:url:_urls'
    
    # MCP
    '*--mcp-config[load MCP servers from JSON files/strings]:config: '
    '--strict-mcp-config[only use MCP servers from --mcp-config]'
    '--mcp-debug[deprecated, use --debug]'
    '*--channels[MCP server channels to listen on]:channel (plugin\:name@marketplace): '
    '--dangerously-load-development-channels[enable dev channels not on allowlist]:channel: '
    
    # Debug / verbose
    '(-d --debug)'{-d,--debug}'[enable debug mode with optional filter]:filter: '
    '--debug-file[write debug logs to specific path]:path:_files'
    '--verbose[override verbose mode setting]'
    
    # IDE / Chrome / tmux / worktree
    '--ide[auto-connect to IDE on startup]'
    '--chrome[enable Claude in Chrome integration]'
    '--no-chrome[disable Claude in Chrome integration]'
    '(-w --worktree)'{-w,--worktree}'[create new git worktree for session]::name: '
    '--tmux=[create tmux session for worktree]::mode:(classic)'
    
    # Other
    '--bare[minimal mode: skip hooks, LSP, plugin sync, etc.]'
    '--safe-mode[start with all customizations disabled for troubleshooting]'
    '--brief[enable SendUserMessage tool for agent-to-user communication]'
    '--disable-slash-commands[disable all skills]'
    '--init[run setup hooks with init matcher (--print only)]'
    '--init-only[run setup and SessionStart hooks then exit]'
    '--maintenance[run setup hooks with maintenance matcher (--print only)]'
    '--teammate-mode[agent team display mode]:mode:(auto in-process tmux)'
    '(--rc --remote-control)'{--rc,--remote-control}'[start interactive session with Remote Control enabled]:name: '
    '--remote-control-session-name-prefix[prefix for auto-generated RC session names]:prefix: '
    '--remote[create web session on claude.ai]:task description: '
    '--teleport[resume web session in local terminal]'
    '--setting-sources[comma-separated setting sources]: :_claude_setting_sources'
    '--settings[path to settings JSON file or JSON string]:file or json: '
    '--exclude-dynamic-system-prompt-sections[move per-machine sections to first user message]'
    '--from-pr[resume session linked to PR]:pr number/url: '
    
    # Help / version
    '(-h --help)'{-h,--help}'[display help]'
    '(-v --version)'{-v,--version}'[output version number]'
  )
  
  # --- subcommand dispatch ---
  _arguments -C -S \
  $opts \
  '1: :_claude_cmd' \
  '*::arguments:->subargs' \
  && ret=0
  
  case "$state" in
    subargs)
      case "$line[1]" in
        agents)       _claude_agents "$@" && ret=0 ;;
        auth)         _claude_auth "$@" && ret=0 ;;
        auto-mode)    _claude_auto_mode "$@" && ret=0 ;;
        daemon)       _claude_daemon "$@" && ret=0 ;;
        doctor)       _claude_help_opts "$@" && ret=0 ;;
        install)      _claude_install "$@" && ret=0 ;;
        attach|kill|stop|rm|logs) _claude_attach "$@" && ret=0 ;;
        mcp)          _claude_mcp "$@" && ret=0 ;;
        plugin|plugins) _claude_plugin "$@" && ret=0 ;;
        project)      _claude_project "$@" && ret=0 ;;
        remote-control) _claude_remote_control_cmd "$@" && ret=0 ;;
        respawn)      _claude_respawn_cmd "$@" && ret=0 ;;
        setup-token)  _claude_help_opts "$@" && ret=0 ;;
        ultrareview)  _claude_ultrareview "$@" && ret=0 ;;
        update|upgrade) _claude_help_opts "$@" && ret=0 ;;
        *)            _default && ret=0 ;;
      esac
    ;;
  esac
  
  return ret
}

_claude "$@"
