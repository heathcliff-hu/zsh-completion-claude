_claude_auth_status() {
  _arguments \
  '--json[output as JSON]' \
  '--text[output as human-readable text]' \
  '-h[display help]' \
  '--help[display help]'
}

_claude_auth() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  
  _arguments -C \
  '-h[display help]' \
  '--help[display help]' \
  '1: :_claude_auth_cmds' \
  '*:: :->subargs' \
  && return
  
  case "$state" in
    subargs)
      case "$line[1]" in
        login)  _claude_auth_login "$@" && return ;;
