_claude_plugin() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  
  _arguments -C \
  '-h[display help]' \
  '--help[display help]' \
  '1: :_claude_plugin_cmds' \
  '*:: :->subargs' \
  && return
  
  case "$state" in
    subargs)
      case "$line[1]" in
        details)
          _arguments \
          '-h[display help]' '--help[display help]' \
          '1:plugin name:_claude_plugins' && return
        ;;
        disable)
          _arguments \
          '(-a --all)'{-a,--all}'[disable all enabled plugins]' \
          '(-s --scope)'{-s,--scope}'[installation scope]:scope:(user project local)' \
          '-h[display help]' '--help[display help]' \
          '1:plugin name:_claude_plugins' && return
        ;;
        enable)
          _arguments \
          '(-s --scope)'{-s,--scope}'[installation scope]:scope:(user project local)' \
          '-h[display help]' '--help[display help]' \
          '1:plugin name:_claude_plugins' && return
        ;;
        init|new)
          _arguments \
          '-h[display help]' '--help[display help]' \
          '1:plugin name: ' && return
        ;;
        install|i)
          _arguments \
          '-h[display help]' '--help[display help]' \
          '1:plugin: ' && return
        ;;
        list)
          _arguments \
          '--available[include available plugins from marketplaces]' \
          '--json[output as JSON]' \
          '-h[display help]' '--help[display help]' && return
        ;;
        prune|autoremove)
          _arguments \
          '--dry-run[list what would be removed without removing]' \
          '(-s --scope)'{-s,--scope}'[prune at scope]:scope:(user project local)' \
          '(-y --yes)'{-y,--yes}'[skip confirmation prompt]' \
          '-h[display help]' '--help[display help]' && return
        ;;
        tag)
          _arguments \
          '-h[display help]' '--help[display help]' \
          '1:path:_files -/' && return
        ;;
        uninstall|remove)
          _arguments \
          '--keep-data[preserve plugin persistent data directory]' \
          '--prune[also remove auto-installed dependencies no longer needed]' \
          '(-s --scope)'{-s,--scope}'[uninstall from scope]:scope:(user project local)' \
          '(-y --yes)'{-y,--yes}'[skip --prune confirmation prompt]' \
          '-h[display help]' '--help[display help]' \
          '1:plugin name:_claude_plugins' && return
        ;;
        update)
          _arguments \
          '(-s --scope)'{-s,--scope}'[installation scope]:scope:(user project local managed)' \
          '-h[display help]' '--help[display help]' \
          '1:plugin name:_claude_plugins' && return
        ;;
        validate)
          _arguments \
          '-h[display help]' '--help[display help]' \
          '1:path:_files' && return
        ;;
        marketplace)
          _claude_plugin_marketplace "$@" && return
        ;;
      esac
    ;;
  esac
}

