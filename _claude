_claude_mcp_servers() {
  local -a items
  local cache_file=$ZSH_CACHE_DIR/zsh_claude_mcp_servers
  
  # cache with 1h TTL: line1 = epoch, rest = server names
  if [[ -f $cache_file ]] && (( $(date +%s) - $(head -1 $cache_file) < 3600 )); then
    items=(${(f)"$(tail -n +2 $cache_file)"})
  else
    items=("${(@f)$(claude mcp list 2>/dev/null | grep ':')}")
    if [[ ${#items} -gt 0 ]]; then
      # shellcheck disable=SC1073 disable=SC1056 disable=SC1072 disable=SC1083
      { date +%s; print -l -- $items } > $cache_file
    fi
  fi
  
  [[ ${#items} -eq 0 ]] && return 1
  _describe 'server' items
}

