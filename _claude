_claude() {
  local -a opts line state
  local curcontext="$curcontext" ret=1
  
  # --- main options ---
  # grouped for readability; empty description lines separate logical groups
  opts=(
    # Output / session control
    '(-p --print)'{-p,--print}'[print response and exit (non-interactive)]'
    '(-c --continue)'{-c,--continue}'[continue most recent conversation]'
    '(-r --resume)'{-r,--resume}'[resume conversation by session ID]:session:_claude_resume'
    '--fork-session[fork new session ID when resuming]'
    '--session-id[use specific session ID]:uuid: '
    '(-n --name)'{-n,--name}'[set display name for session]:name: '
    '--no-session-persistence[disable session persistence (--print only)]'
    
    # Model / effort
    '--model[model for current session]:model:_claude_models'
    '--effort[effort level for current session]:level:(low medium high xhigh max)'
    '--fallback-model[enable fallback to specified model(s)]:model:_claude_models'
    '--max-budget-usd[max dollar amount for API calls (--print only)]:amount: '
    
    # Input / output format
    '--input-format[input format (--print only)]:format:(text stream-json)'
    '--output-format[output format (--print only)]:format:(text json stream-json)'
    '--json-schema[JSON Schema for structured output validation]:schema: '
    '--include-partial-messages[include partial message chunks (--print + stream-json)]'
    '--include-hook-events[include hook lifecycle events (stream-json)]'
    '--replay-user-messages[re-emit user messages from stdin (stream-json)]'
    
    # Permissions / tools
    '--permission-mode[permission mode for session]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)'
    '--tools[specify list of available tools]: :_claude_tool_names'
    '--allowedTools[comma/space-separated tool names to allow]: :_claude_tool_names'
    '--allowed-tools[comma/space-separated tool names to allow]: :_claude_tool_names'
    '--disallowedTools[comma/space-separated tool names to deny]: :_claude_tool_names'
    '--disallowed-tools[comma/space-separated tool names to deny]: :_claude_tool_names'
    '--allow-dangerously-skip-permissions[enable bypassing all permission checks as option]'
    '--dangerously-skip-permissions[bypass all permission checks]'
    
    # System prompt / agents
    '--system-prompt[system prompt to use for session]:prompt: '
    '--append-system-prompt[append system prompt to default]:prompt: '
    '--agent[agent for current session]:agent: '
    '--agents[json object defining custom agents]:json: '
    '*--betas[beta headers to include in API requests]:betas: '
    
    # Directories / files / plugins
    '*--add-dir[additional directories for tool access]:directories:_directories'
    '*--file[file resources to download at startup]:spec (file_id\:relative_path):_cmd_file_spec'
    '--plugin-dir[load plugin from directory or .zip]:path:_cmd_plugin_dir'
    '--plugin-url[fetch plugin .zip from URL]:url:_urls'
    
    # MCP
    '--mcp-config[load MCP servers from JSON files/strings]:config: '
    '--strict-mcp-config[only use MCP servers from --mcp-config]'
    '--mcp-debug[deprecated, use --debug]'
    
    # Debug / verbose
    '(-d --debug)'{-d,--debug}'[enable debug mode with optional filter]:filter: '
    '--debug-file[write debug logs to specific path]:path:_files'
    '--verbose[override verbose mode setting]'
    
    # IDE / Chrome / tmux / worktree
    '--ide[auto-connect to IDE on startup]'
    '--chrome[enable Claude in Chrome integration]'
    '--no-chrome[disable Claude in Chrome integration]'
    '--tmux[create tmux session for worktree (requires --worktree)]'
    '(-w --worktree)'{-w,--worktree}'[create new git worktree for session]:name: '
    
    # Other
    '--bare[minimal mode: skip hooks, LSP, plugin sync, etc.]'
    '--brief[enable SendUserMessage tool for agent-to-user communication]'
    '--disable-slash-commands[disable all skills]'
    '--remote-control[start interactive session with Remote Control enabled]:name: '
    '--remote-control-session-name-prefix[prefix for auto-generated RC session names]:prefix: '
    '--prompt-suggestions[enable prompt suggestions]'
    '--setting-sources[comma-separated setting sources]: :_claude_setting_sources'
    '--settings[path to settings JSON file or JSON string]:file or json: '
    '--exclude-dynamic-system-prompt-sections[move per-machine sections to first user message]'
    '--from-pr[resume session linked to PR]:pr number/url: '
    
    # Help / version
    '(-h --help)'{-h,--help}'[display help]'
    '(-v --version)'{-v,--version}'[output version number]'
  )
  
  # --- subcommand dispatch ---
  _arguments -C -S \
  $opts \
  '1: :_claude_cmd' \
  '*::arguments:->subargs' \
  && ret=0
  
  case "$state" in
    subargs)
      case "$line[1]" in
        agents)       _claude_agents "$@" && ret=0 ;;
        auth)         _claude_auth "$@" && ret=0 ;;
        auto-mode)    _claude_auto_mode "$@" && ret=0 ;;
        doctor)       _claude_help_opts "$@" && ret=0 ;;
        install)      _claude_install "$@" && ret=0 ;;
        mcp)          _claude_mcp "$@" && ret=0 ;;
        plugin|plugins) _claude_plugin "$@" && ret=0 ;;
        project)      _claude_project "$@" && ret=0 ;;
        setup-token)  _claude_help_opts "$@" && ret=0 ;;
        ultrareview)  _claude_ultrareview "$@" && ret=0 ;;
        update|upgrade) _claude_help_opts "$@" && ret=0 ;;
        *)            _default && ret=0 ;;
      esac
    ;;
  esac
  
  return ret
}

_claude "$@"
