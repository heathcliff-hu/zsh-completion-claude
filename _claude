# ------------------------------------------------------------------------------
# Zsh completion for claude (Claude Code CLI)
# Version: 2.1.177
#
# Generated from `claude --help` output. Subcommands use basic completions
# where nested help was not fetched. Rerun `claude <sub> --help` to
# flesh out subcommand options when they change.
# ------------------------------------------------------------------------------

zmodload -F zsh/stat b:zstat 2>/dev/null
zmodload -F zsh/datetime b:strftime 2>/dev/null
zmodload -F zsh/datetime b:epochtime 2>/dev/null

# Guard: skip completion generation when required dependency missing
# Usage: _claude_need cmd1 cmd2 ... || return 1
_claude_need() {
  local cmd
  for cmd in "$@"; do
    (( $+commands[$cmd] )) || return 1
  done
  return 0
}

_claude_cmd() {
  # only offer subcommands at word position 2 (claude <Tab>), not after options
  (( CURRENT == 2 )) || return 1

  local -a commands
  commands=(
    'agents:manage background agents'
    'attach:attach to background session'
    'auth:manage authentication'
    'auto-mode:inspect auto mode classifier configuration'
    'daemon:manage background daemon'
    'doctor:check health of auto-updater'
    'install:install Claude Code native build'
    'kill:stop background session'
    'logs:print recent output from background session'
    'mcp:configure and manage MCP servers'
    'plugin:manage Claude Code plugins'
    'plugins:manage Claude Code plugins'
    'project:manage Claude Code project state'
    'remote-control:start Remote Control server'
    'respawn:restart background session'
    'rm:remove background session from list'
    'setup-token:set up long-lived authentication token'
    'stop:stop background session'
    'ultrareview:run cloud-hosted multi-agent code review'
    'update:check for updates and install'
    'upgrade:check for updates and install'
  )
  _describe -t commands 'claude command' commands
}

